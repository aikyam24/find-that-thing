{
  "manifest_version": 3,
  "name": "Find That Thing",
  "version": "0.1.0",
  "description": "Save pages in one click. Find them again by describing what you remember.",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": ["storage", "sidePanel", "activeTab", "scripting", "alarms"],
  "optional_permissions": ["history"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Save this page and open Find That Thing",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save this page and open search"
    },
    "open-search": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "Command+Shift+F" },
      "description": "Open Find That Thing without saving"
    }
  }
}
